# Copy to .env and fill in your own values. Only needed for HTTP mode (--http).
# The default stdio mode requires none of these.

# OAuth client identifier advertised to the MCP client.
MCP_CLIENT_ID=mcp-rlbook

# OAuth client secret. Generate one, e.g. `openssl rand -hex 32`.
MCP_CLIENT_SECRET=

# Public base URL the server is reachable at (used to build OAuth redirect URIs).
# Must be https:// for remote clients such as claude.ai.
MCP_BASE_URL=https://your-domain.example.com

# PIN used by the browser-based authorization page to approve a client.
MCP_ACCESS_PIN=
